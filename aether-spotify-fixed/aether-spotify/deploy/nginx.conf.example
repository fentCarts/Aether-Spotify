# Reverse proxy for the Aether Node process (assumed to run on 127.0.0.1:8888).
# Copy to /etc/nginx/sites-available/aether, symlink into sites-enabled, then
# run: sudo certbot --nginx -d yourdomain.com   (installs the SSL block for you)

server {
    listen 80;
    server_name yourdomain.com;

    location / {
        proxy_pass http://127.0.0.1:8888;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
